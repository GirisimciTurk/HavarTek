# --- Site ---
# Kanonik adres; sitemap, robots.txt ve og:url bunu kullanır.
NEXT_PUBLIC_SITE_URL=https://dronetek.com.tr

# --- Form e-postası (SMTP) ---
# Bu değerler boşsa site çalışmaya devam eder; form gönderimleri
# sunucu günlüğüne yazılır ve kullanıcıya başarı ekranı gösterilmez.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Gönderen ve alıcı adresleri
MAIL_FROM="DroneTek Web <web@dronetek.com.tr>"
MAIL_TO=iletisim@dronetek.com.tr
