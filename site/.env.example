# --- Site ---
# Kanonik adres; sitemap, robots.txt, canonical ve og:url bunu kullanır.
# Derleme anında gömülür: değiştirince yeniden derlemek gerekir.
NEXT_PUBLIC_SITE_URL=https://havartek.com

# --- Form e-postası (SMTP) ---
# Bu değerler boşsa site çalışmaya devam eder; form gönderimleri
# sunucu günlüğüne yazılır ve kullanıcıya başarı ekranı gösterilmez.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Gönderen adresi (SMTP hesabının gönderebildiği bir adres olmalı)
MAIL_FROM="HavarTek.com Web <web@havartek.com>"
# Talep ve bülten formlarının düşeceği kutu
MAIL_TO=bedirkaraabali@girisimciturk.com
